{
  "name": "gym-program-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "vercel:dev": "npx vercel dev",
    "build": "node scripts/build-static.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "password:hash": "node scripts/hash-password.js",
